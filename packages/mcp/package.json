{
  "name": "@skilljit/mcp",
  "version": "0.1.0",
  "description": "MCP stdio server exposing skilljit's fixed 5-tool surface for just-in-time skill and MCP-tool routing",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skilljit-mcp": "./dist/serve.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/serve.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@skilljit/core": "^0.1.0",
    "@skilljit/proxy": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
